# Antigravity Configuration
# Get your API key from Antigravity Settings -> API Keys
ANTIGRAVITY_API_KEY=YOUR_API_KEY_HERE
ANTIGRAVITY_BASE_URL=http://localhost:8080
ANTIGRAVITY_PROJECT_ID=nexus-hub

# Webhook Configuration
WEBHOOK_PORT=3001
ANTIGRAVITY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Project Configuration
PROJECT_NAME=Nexus Hub
PROJECT_REPO=https://github.com/your-org/nexus-hub
PROJECT_BRANCH=main

# Integration Features
ENABLE_AUTO_SYNC=true
ENABLE_WEBHOOKS=true
LOG_TO_ANTIGRAVITY=true
