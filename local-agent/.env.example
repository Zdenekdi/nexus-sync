BACKEND_URL=https://váš-server.com
# DOPORUČENO (full-auto): API klíč se scopem 'relay:bridge' z dashboardu (Developer API).
# Neexpiruje, revokovatelný smazáním klíče. Nastavíš jednou a agent jede navždy.
AGENT_API_KEY=nx_live_xxxxxx.tajný_secret
# LEGACY fallback: 30denní JWT z dashboardu (expiruje, nutno přegenerovat). Použij
# jen jedno z AGENT_API_KEY / RELAY_TOKEN — API klíč má přednost.
RELAY_TOKEN=
ADS_POWER_PORT=50325
CAPSOLVER_KEY=váš_capsolver_api_klíč
# V AdsPower v nastavení -> API se ujistěte, že je API zapnuté na portu 50325
