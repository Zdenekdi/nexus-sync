# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/nexus_prod"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-32-chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SECRET=your-device-secret-min-16-chars

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-app.web.app,https://your-app.firebaseapp.com

# ── Firebase (for push notifications) ────────────────────────────────────────
# Option 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-auth.json
# Option 2: Inline JSON (for containers/CI)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Vultr & SSH Infrastructure ────────────────────────────────────────────────
VULTR_API_KEY=your-vultr-api-key
VULTR_INSTANCE_ID=your-instance-id
SSH_HOST=your-server.example.com
SSH_USER=root
SSH_KEY_PATH=/root/.ssh/id_rsa

# ── Asterisk / SIP ───────────────────────────────────────────────────────────
VPS_SSH_HOST=your-vps-ip
VPS_SSH_USER=root
VPS_SSH_KEY_PATH=/root/.ssh/id_rsa
ASTERISK_CONF_DIR=/etc/asterisk
ASTERISK_WS_PORT=8089
ASTERISK_SIP_PORT=5060

# SIP password encryption key (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIP_ENCRYPTION_KEY=your-sip-encryption-key

# ── Telegram Alerts (optional) ───────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id
