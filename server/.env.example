# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/nexus_prod"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-32-chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SECRET=your-device-secret-min-16-chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-encryption-key-min-32-chars

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-app.web.app,https://your-app.firebaseapp.com

# ── Firebase (for push notifications) ────────────────────────────────────────
# Option 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-auth.json
# Option 2: Inline JSON (for containers/CI)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Vultr Backend Infrastructure ─────────────────────────────────────────────
VULTR_API_KEY=your-vultr-api-key
VULTR_INSTANCE_ID=your-instance-id
SSH_HOST=your-vultr-backend.example.com
SSH_USER=root
SSH_KEY_PATH=/root/.ssh/id_ed25519
PM2_BACKEND_NAME=nexus-backend-final
PM2_AI_TUNNEL_NAME=ai-tunnel

# ── Hetzner AI Infrastructure ─────────────────────────────────────────────────
HETZNER_API_KEY=your-hetzner-api-key
HETZNER_SERVER_ID=your-hetzner-server-id
HETZNER_SSH_HOST=your-hetzner-ai-node.example.com
HETZNER_SSH_USER=root

# Ollama endpoint used by /api/ai. Use a private Hetzner URL, VPN address,
# or an SSH tunnel that exposes the AI node to the backend/container.
AI_BASE_URL=http://127.0.0.1:11434/api
AI_MODEL=llama3.1:8b-instruct-q4_0
AI_TIMEOUT_MS=60000
AI_TUNNEL_REQUIRED=false
AI_TUNNEL_LOCAL_PORT=11434
AI_TUNNEL_REMOTE_HOST=127.0.0.1
AI_TUNNEL_REMOTE_PORT=11434

# ── Asterisk / SIP ───────────────────────────────────────────────────────────
VPS_SSH_HOST=your-vps-ip
VPS_SSH_USER=root
VPS_SSH_KEY_PATH=/root/.ssh/id_rsa
ASTERISK_CONF_DIR=/etc/asterisk
ASTERISK_WS_PORT=8089
ASTERISK_SIP_PORT=5060

# SIP password encryption key (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIP_ENCRYPTION_KEY=your-sip-encryption-key

# ── Telegram Alerts (optional) ───────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ── Sentry Error Tracking (optional) ────────────────────────────────────────
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Stripe Billing (optional; required for card checkout) ───────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional fixed Stripe Price IDs. When omitted, the backend creates/reuses
# test/live Stripe Prices by lookup_key for the canonical plans.
# STRIPE_PRICE_STARTER_MONTHLY_CZK=price_xxx
# STRIPE_PRICE_PRO_MONTHLY_CZK=price_xxx
# STRIPE_PRICE_AGENCY_MONTHLY_CZK=price_xxx
# ── Platba převodem (volitelné) ─────────────────────────────────────────────
# Fail-closed: dokud tohle není 'true', převod se zákazníkům vůbec nenabízí.
# Nabídnout ho dřív, než je čím platby párovat, znamená vybrat peníze
# a nezapnout službu.
ALLOW_BANK_TRANSFER_BILLING=false

# Účet, na který chodí platby. Není to tajemství — patří na fakturu —, ale je
# v konfiguraci, aby jeho změna nevyžadovala nové sestavení klienta.
BANK_ACCOUNT_NUMBER=2703576806/2010
BANK_NAME=Fio banka, a.s.
BANK_BIC=FIOBCZPPXXX
# BANK_IBAN=CZ...
# BANK_ACCOUNT_HOLDER=Jméno majitele účtu
# Kolik dní má zákazník na zaplacení, než čekající objednávka propadne.
BANK_TRANSFER_DUE_DAYS=14

# Token k Fio API pro automatické párování plateb. Bez něj převod funguje,
# ale platby musí App Owner potvrzovat ručně.
#
# Kde ho vzít (dokumentace „FIO API BANKOVNICTVÍ" v1.9, kap. 2):
#   1. Přihlas se do internetového bankovnictví Fio.
#   2. Nastavení (vpravo nahoře) → záložka API → Přidat nový token.
#   3. Zvol typ práv "Sledování účtu" — NE variantu se zadáváním příkazů.
#      Worker jen čte; token, který umí posílat peníze, nemá na serveru co dělat.
#   4. Požadavek potvrď silnou autorizací (SMS / push).
#   5. Token použij až za 5 minut po autorizaci, dřív ho API nepřijme.
#
# POZOR: platnost tokenu je nejvýš 180 dní a bez platnosti ho nelze založit.
# Zapni automatické prodlužování, jinak jednou vyprší a párování se zastaví.
# Fio pak vrací HTTP 500 (kap. 8.4); worker na to upozorní přes alertService.
# FIO_API_TOKEN=

# ── Operational monitoring (optional) ───────────────────────────────────────
# Set to true when card checkout is expected to be available.
REQUIRE_STRIPE_CONFIG=false
# Alert when a Stripe/card pending subscription is older than this many minutes.
PENDING_BILLING_ALERT_MINUTES=60
# Alert when an active Relay device has not checked in for this many minutes.
RELAY_OFFLINE_ALERT_MINUTES=15
# Avoid repeating the same Telegram alert too often.
MONITOR_ALERT_COOLDOWN_MINUTES=60

# ── APK distribuce z CI ─────────────────────────────────────────────────────
# Token, kterým CI nahrává sestavené APK (POST /api/vultr/upload-apk). Nahrazuje
# dřívější dlouhodobý JWT App Ownera — ten vypršel a distribuce buildů tiše padala
# na 401. Musí být stejný jako GitHub secret APK_DEPLOY_TOKEN.
# Minimálně 32 znaků; bez nastavení je tahle cesta vypnutá a upload vyžaduje
# přihlášení App Ownera. Kdo token má, může nahrát APK, které si uživatelé
# nainstalují — zacházej s ním jako s nasazovacím klíčem.
APK_DEPLOY_TOKEN=
