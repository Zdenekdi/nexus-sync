generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  email     String?
  region    String
  plan      String   @default("Standard")
  tier      String   @default("Standard")
  inviteCode String?  @unique
  safetyAlertMode String @default("MANAGERS_AND_ASSIGNED") // MANAGERS_AND_ASSIGNED, ASSIGNED_ONLY
  extraFeatures String?  // JSON string for purchased add-ons or bonuses
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  referralCode String? @unique
  referrals   Referral[] @relation("AgencyReferrer")
  referralOf  Referral?  @relation("AgencyReferred")

  users     User[]
  roles     Role[]
  profiles  Profile[]
  chats     Chat[]
  pushDevices PushDevice[]
  deviceBindings DeviceBinding[]
  auditLogs  AuditLog[]
  subscriptions Subscription[]
}

model Subscription {
  id           String   @id @default(cuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  plan         String   // MONTHLY | SEMI_ANNUAL | ANNUAL
  status       String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED | TRIAL
  startedAt    DateTime @default(now())
  expiresAt    DateTime
  cancelledAt  DateTime?
  amountPaid   Float?
  currency     String   @default("CZK")
  paymentRef   String?  // external payment ID (GoPay, Stripe, etc.)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId])
  @@index([status])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  permissions String   // JSON string
  minTier     String?  // Optional minimum tier required to use this role
  isAppOwner   Boolean  @default(false)
  isManager    Boolean  @default(false)
  agencyId    String?
  agency      Agency?  @relation(fields: [agencyId], references: [id])
  
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, agencyId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id])
  messages  Message[]
  pushDevices PushDevice[]
  deviceBindings DeviceBinding[]
  assignedProfiles Profile[] @relation("ProfileAssignees")
  auditLogs  AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  token     String   @unique
  platform  String   @default("android")
  active    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([userId])
}

model DeviceBinding {
  id             String   @id @default(cuid())
  installationId String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId       String?
  agency         Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  profileId      String?
  profile        Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  platform       String   @default("android")
  active         Boolean  @default(true)
  model          String?
  deviceName     String?
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([agencyId])
  @@index([userId])
  @@index([profileId])
}

model Profile {
  id          String    @id @default(cuid())
  name        String
  phoneNumber String?
  status      String    @default("offline")
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id])
  data        String?
  chats       Chat[]
  callLogs    CallLog[]
  bookings    Booking[]
  sessions    SafetySession[]
  qaRecords   QaRecord[]
  icalUrl     String?
  deviceBindings DeviceBinding[]
  assignees   User[]    @relation("ProfileAssignees")
  clientNotes ClientNote[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ClientNote {
  id          String   @id @default(cuid())
  agencyId    String
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  clientPhone String
  text        String
  authorName  String
  createdAt   DateTime @default(now())

  @@index([agencyId])
  @@index([profileId])
  @@index([clientPhone])
}

model Booking {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id])
  agencyId    String
  title       String
  startTime   DateTime
  endTime     DateTime
  locationType  String    @default("incall") // incall or outcall
  source        String?   // "manual", "ical"
  
  safetySession SafetySession?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SafetySession {
  id            String    @id @default(cuid())
  agencyId      String
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id])
  bookingId     String?   @unique
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  locationType  String    @default("incall") 
  
  state         String    @default("PLANNED") // PLANNED, CHECKED_IN, GRACE, ESCALATED, RESOLVED
  plannedEndAt  DateTime?
  graceUntil    DateTime?
  escalatedAt   DateTime?
  resolvedAt    DateTime?
  
  locationPoints SafetyLocationPoint[]
  emergencyEvents EmergencyEvent[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SafetyLocationPoint {
  id            String    @id @default(cuid())
  sessionId     String
  session       SafetySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lat           Float
  lng           Float
  accuracy      Float?
  capturedAt    DateTime
  receivedAt    DateTime  @default(now())
}

model EmergencyEvent {
  id            String    @id @default(cuid())
  sessionId     String
  session       SafetySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type          String    // panic, timeout
  severity      String    @default("high")
  
  receipts      EmergencyReceipt[]
  createdAt     DateTime  @default(now())
}

model EmergencyReceipt {
  id            String    @id @default(cuid())
  eventId       String
  event         EmergencyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipientId   String    // User ID
  recipientRole String
  deliveredAt   DateTime  @default(now())
  acknowledgedAt DateTime?
}

model Chat {
  id            String    @id @default(cuid())
  externalId    String
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id])
  agencyId      String
  agency        Agency    @relation(fields: [agencyId], references: [id])
  messages      Message[]
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([externalId, profileId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  direction String
  transport String?
  text      String
  status    String   @default("sent")
  senderId  String?
  sender    User?    @relation(fields: [senderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CallLog {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  from      String
  duration  Int      @default(0)
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryLocation {
  id        String   @id @default(cuid())
  name      String
  agencyId  String?
  items     InventoryItem[]
  createdAt DateTime @default(now())

  @@index([agencyId])
}

model InventoryItem {
  id          String            @id @default(cuid())
  name        String
  quantity    Int               @default(0)
  threshold   Int               @default(10)
  locationId  String
  location    InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  agencyId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([agencyId])
  @@index([locationId])
}

model AuditLog {
  id        String   @id @default(cuid())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   
  details   String?  
  timestamp DateTime @default(now())

  @@index([agencyId])
}

model QaRecord {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  rating    Int      @default(5)
  comment   String?
  category  String?  
  createdAt DateTime @default(now())

  @@index([profileId])
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referrer     Agency   @relation("AgencyReferrer", fields: [referrerId], references: [id])
  referredId   String   @unique
  referred     Agency   @relation("AgencyReferred", fields: [referredId], references: [id])
  status       String   @default("pending") 
  rewardAmount Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([referrerId])
}

model DailyStat {
  id           String   @id @default(cuid())
  agencyId     String
  date         DateTime 
  revenue      Float    @default(0)
  bookingsCount Int      @default(0)
  activeProfiles Int     @default(0)

  @@unique([agencyId, date])
}

model GlobalSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // Stores "true"/"false" or JSON strings
  updatedAt DateTime @updatedAt
}
